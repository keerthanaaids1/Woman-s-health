# AURA CARE SANCTUARY - Environment Variables
PORT=8000
HOST=0.0.0.0

# Optional MongoDB Atlas or Local URI (Automatic graceful fallback to in-memory store if unavailable)
MONGODB_URI=mongodb://localhost:27017/aura_care_sanctuary

# AI Keys (Free Tier - Groq or Gemini 1.5 Flash). 
# If empty, built-in deterministic clinical rule engine runs offline automatically.
GROQ_API_KEY=
GEMINI_API_KEY=
